{
  "name": "pixelquest",
  "private": true,
  "version": "0.1.0",
  "description": "PixelQuest - My Portfolio Adventure: a responsive pixel-art RPG portfolio",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
